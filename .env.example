# Blaaiz sandbox credentials. Copy to .env (never commit .env).
# Leave blank to run Kolo in clearly-labelled MOCK mode.
BLAAIZ_BASE_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
# Legacy alternative to OAuth:
BLAAIZ_API_KEY=
# The circle's pot wallet + verified customer used for payouts
BLAAIZ_WALLET_ID=
BLAAIZ_CUSTOMER_ID=
