# Blaaiz SANDBOX OAuth credentials (Dashboard → API & Webhooks). Copy to .env, never commit .env.
# Leave blank to run Kolo in clearly-labelled MOCK mode.
BLAAIZ_BASE_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
# Optional, space-separated. Default: fees:read payout:create transaction:read bank:read wallet:read
BLAAIZ_OAUTH_SCOPE=
# The pot wallet (USD) and your VERIFIED business customer, both from the dashboard
BLAAIZ_WALLET_ID=
BLAAIZ_CUSTOMER_ID=
